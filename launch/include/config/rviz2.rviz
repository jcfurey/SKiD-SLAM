      Color: 255; 255; 255
      Color Transformer: FlatColor
      Decay Time: 0.0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: Key poses
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.3
      Style: Spheres
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /jackal0/liorf/mapping/trajectory
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 1.0
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 255; 255
      Enabled: true
      Head Diameter: 0.0
      Head Length: 0.0
      Length: 0.3
      Line Style: Lines
      Line Width: 0.03
      Name: Path (mapping)
      Offset:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.0
      Shaft Length: 0.0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /jackal0/liorf/mapping/path
      Value: true
    - Alpha: 1.0
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 0; 0
      Enabled: false
      Head Diameter: 0.0
      Head Length: 0.0
      Length: 0.3
      Line Style: Lines
      Line Width: 0.03
      Name: Path (IMU)
      Offset:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.0
      Shaft Length: 0.0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /jackal0/liorf/imu/path
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Color Style: Unique
          Frame: Local
          Offset: 1.0
          Scale: 1.0
          Value: true
        Position:
          Alpha: 0.3
          Color: 204; 51; 204
          Scale: 1.0
          Value: true
        Value: false
      Enabled: false
      Keep: 1
      Name: Odometry (mapping)
      Position Tolerance: 0.1
      Shape:
        Alpha: 1.0
        Axes Length: 1.0
        Axes Radius: 0.1
        Color: 255; 255; 255
        Head Length: 0.3
        Head Radius: 0.1
        Shaft Length: 1.0
        Shaft Radius: 0.05
        Value: Axes
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /jackal0/liorf/mapping/odometry
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
