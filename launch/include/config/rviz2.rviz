        Axes Length: 1.0
        Axes Radius: 0.1
        Color: 255; 0; 0
        Head Length: 0.3
        Head Radius: 0.1
        Shaft Length: 1.0
        Shaft Radius: 0.05
        Value: Axes
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /jackal0/odometry/imu
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Loop constraints
      Namespaces: {}
      Topic:
        Depth: 100
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /jackal0/liorf/mapping/loop_closure_constraints
      Value: true
    Enabled: true
    Name: jackal0
    Value: true
